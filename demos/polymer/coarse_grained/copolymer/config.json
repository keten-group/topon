{
    "study": {
        "name": "cg_copolymer",
        "output_dir": "output_copolymer"
    },
    "topology": {
        "source": "generate",
        "generator": {
            "lattice_size": "5x5x5",
            "lattice_type": "SC",
            "max_functionality": 4,
            "degree_distribution": "0:0,1:25"
        }
    },
    "chemistry": {
        "model_type": "coarse_grained",
        "bead_density": 0.85,
        "degree_of_polymerization": 20,
        "monomers": {
            "PDMS": {
                "smiles": "[Si](C)(C)O",
                "chain_head": "Si",
                "chain_tail": "O"
            },
            "A": {
                "smiles": "[Si](C)(C)O",
                "chain_head": "Si",
                "chain_tail": "O"
            },
            "B": {
                "smiles": "[Si](C)(C)O",
                "chain_head": "Si",
                "chain_tail": "O"
            }
        }
    },
    "assignment": {
        "copolymer": {
            "enabled": true,
            "per_edge_type": {
                "A": {
                    "arrangement": "block",
                    "composition": [
                        {
                            "monomer": "A",
                            "fraction": 0.5
                        },
                        {
                            "monomer": "B",
                            "fraction": 0.5
                        }
                    ]
                }
            }
        }
    },
    "conformation": {
        "overlap_cutoff": 0.01,
        "overlap_max_iters": 10
    },
    "simulation": {
        "include_angles": true,
        "pair_style": "attractive"
    },
    "execution": {
        "auto_run": false,
        "executable": "lmp",
        "n_procs": 1
    },
    "__comment_monomers__": "In the coarse-grained model the monomer names only label bead types. The SMILES are not used, but the config validator needs every label declared in chemistry.monomers."
}
