    24 = max # of special neighbors
  special bonds CPU = 0.011 seconds

variable        scale equal ramp(0.001,1.0)
fix             ramp all adapt 1 pair lj/cut/coul/long epsilon 1*2 2 v_scale pair lj/cut/coul/long epsilon 2 3*5 v_scale pair lj/cut/coul/long epsilon 1*5 5 v_scale scale yes reset no
fix             lang all langevin 300.0 300.0 100.0 7811
fix             cap all nve/limit 0.1
timestep        1.0
thermo          1000
# RUNTIME: 2500 steps
run             2500
