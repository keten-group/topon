package omp 4
using multi-threaded neighbor list subroutines
# LAMMPS Stage 3: Parallel Equilibration
# METHODOLOGY: Set 1 (Tight Min -> NVT -> NPT)

units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  cvff
pair_style      lj/cut/coul/long 10.0 10.0

# --- 1. Load Ramped State ---
read_data       system_ramped.data
