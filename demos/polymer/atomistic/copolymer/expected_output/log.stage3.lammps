# --- 2. Safety Settings ---
# Keep these even in stage 3 to prevent random crashes
neigh_modify    one 10000

group           bbdump type 1 3
4531 atoms in group bbdump
dump            bbdump bbdump custom 10 traj_stage3.lammpstrj id xu yu zu
dump_modify     bbdump sort id format float %.4f

# --- 3. Define Potential ---
pair_style      lj/cut/coul/long 10.0 10.0
kspace_style    pppm 1.0e-4
include         ../02_Chemistry/system.in.settings
# Forcefield Settings (Auto-Generated)

# Pair Coeffs
pair_coeff 1 1 0.3100 3.8041 # Si3
pair_coeff 2 2 0.0951 3.4730 # C_3
pair_coeff 3 3 0.0957 3.0332 # O_3
pair_coeff 4 4 0.0951 3.4730 # C_R
pair_coeff 5 5 0.0152 2.8464 # H_
pair_modify mix geometric tail yes

# Bond Coeffs
bond_coeff 1 350.0000 1.6970 # C_3-Si3
bond_coeff 2 350.0000 1.5870 # O_3-Si3
bond_coeff 3 350.0000 1.6270 # C_R-Si3
bond_coeff 4 525.0000 1.3900 # C_R-C_R
bond_coeff 5 350.0000 1.0900 # C_3-H_
bond_coeff 6 350.0000 1.0200 # C_R-H_

# Angle Coeffs
angle_coeff 1 50.0000 109.4710 # O_3-Si3-O_3
angle_coeff 2 50.0000 109.4710 # C_3-Si3-O_3
angle_coeff 3 50.0000 109.4710 # C_3-Si3-C_3
angle_coeff 4 50.0000 109.4710 # H_-C_3-Si3
angle_coeff 5 50.0000 109.4710 # H_-C_3-H_
angle_coeff 6 50.0000 104.5100 # Si3-O_3-Si3
angle_coeff 7 50.0000 109.4710 # C_R-Si3-O_3
angle_coeff 8 50.0000 109.4710 # C_3-Si3-C_R
angle_coeff 9 50.0000 120.0000 # C_R-C_R-Si3
angle_coeff 10 50.0000 120.0000 # C_R-C_R-C_R
angle_coeff 11 50.0000 120.0000 # C_R-C_R-H_

# Dihedral Coeffs
dihedral_coeff 1 0.111111 1 3 # C_3-Si3-C_3-H_
dihedral_coeff 2 0.111111 1 3 # H_-C_3-Si3-O_3
dihedral_coeff 3 0.333333 1 3 # C_3-Si3-O_3-Si3
dihedral_coeff 4 0.333333 1 3 # O_3-Si3-O_3-Si3
dihedral_coeff 5 0.333333 1 3 # C_R-Si3-O_3-Si3
dihedral_coeff 6 0.111111 1 3 # C_R-Si3-C_3-H_
dihedral_coeff 7 0.083333 -1 6 # C_R-C_R-Si3-O_3
dihedral_coeff 8 0.083333 -1 6 # C_3-Si3-C_R-C_R
dihedral_coeff 9 3.125000 -1 2 # C_R-C_R-C_R-Si3
dihedral_coeff 10 3.125000 -1 2 # H_-C_R-C_R-Si3
dihedral_coeff 11 3.125000 -1 2 # C_R-C_R-C_R-C_R
dihedral_coeff 12 3.125000 -1 2 # C_R-C_R-C_R-H_
dihedral_coeff 13 3.125000 -1 2 # H_-C_R-C_R-H_

# Improper Coeffs
improper_coeff 1 13.333333 0.0000 # C_R

special_bonds   lj/coul 0.0 0.0 1.0
