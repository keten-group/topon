  read_data CPU = 0.496 seconds

neigh_modify    one 10000
comm_modify     mode single cutoff 12.0

group           bbdump type 1 3
4531 atoms in group bbdump
dump            bbdump bbdump custom 10 traj_stage2.lammpstrj id xu yu zu
dump_modify     bbdump sort id format float %.4f

pair_style      lj/cut/coul/long 10.0 10.0
kspace_style    pppm 1.0e-4
include         ../02_Chemistry/system.in.settings
# Forcefield Settings (Auto-Generated)

# Pair Coeffs
pair_coeff 1 1 0.3100 3.8041 # Si3
pair_coeff 2 2 0.0951 3.4730 # C_3
pair_coeff 3 3 0.0957 3.0332 # O_3
pair_coeff 4 4 0.0152 2.8464 # H_

# Bond Coeffs
bond_coeff 1 350.0000 1.6970 # C_3-Si3
bond_coeff 2 350.0000 1.5870 # O_3-Si3
bond_coeff 3 350.0000 1.0900 # C_3-H_

# Angle Coeffs
angle_coeff 1 50.0000 109.4710 # O_3-Si3-O_3
angle_coeff 2 50.0000 109.4710 # C_3-Si3-O_3
angle_coeff 3 50.0000 109.4710 # C_3-Si3-C_3
angle_coeff 4 50.0000 109.4710 # H_-C_3-Si3
angle_coeff 5 50.0000 109.4710 # H_-C_3-H_
angle_coeff 6 50.0000 104.5100 # Si3-O_3-Si3

# Dihedral Coeffs
dihedral_coeff 1 0.111111 -1 3 # C_3-Si3-C_3-H_
dihedral_coeff 2 0.111111 -1 3 # H_-C_3-Si3-O_3
dihedral_coeff 3 0.333333 -1 3 # C_3-Si3-O_3-Si3
dihedral_coeff 4 0.333333 -1 3 # O_3-Si3-O_3-Si3

special_bonds   lj/coul 0.0 0.0 1.0
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        1       
     4 = max # of 1-2 neighbors
    10 = max # of 1-3 neighbors
    24 = max # of special neighbors
  special bonds CPU = 0.005 seconds

variable        scale equal ramp(0.001,1.0)
fix             ramp all adapt 1 pair lj/cut/coul/long epsilon 1*2 2 v_scale pair lj/cut/coul/long epsilon 2 3*4 v_scale pair lj/cut/coul/long epsilon 1*4 4 v_scale scale yes reset no
fix             lang all langevin 300.0 300.0 100.0 7811
fix             cap all nve/limit 0.1
timestep        1.0
thermo          1000
# RUNTIME: 5000 steps
run             5000
