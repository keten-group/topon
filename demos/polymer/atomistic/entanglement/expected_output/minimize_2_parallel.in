# LAMMPS Stage 2: epsilon ramp with the backbone at full depth (protocol "hard_backbone")
#
# Pairs with a light atom ramp from 0.001 to 1 of their Lennard-Jones depth;
# backbone-backbone pairs (types 1 3) are at full depth
# from the first step. Capped under a Langevin thermostat: the historic ramp
# runs nve/limit alone and ended a small test network at 964 K.

units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  umbrella
pair_style      soft 3.0

read_data       system_after_soft.data

neigh_modify    one 10000
comm_modify     mode single cutoff 12.0

group           bbdump type 1 3
dump            bbdump bbdump custom 10 traj_stage2.lammpstrj id xu yu zu
dump_modify     bbdump sort id format float %.4f

pair_style      lj/cut/coul/long 10.0 10.0
kspace_style    pppm 1.0e-4
include         ../02_Chemistry/system.in.settings
special_bonds   lj/coul 0.0 0.0 1.0

variable        scale equal ramp(0.001,1.0)
fix             ramp all adapt 1 pair lj/cut/coul/long epsilon 1*2 2 v_scale pair lj/cut/coul/long epsilon 2 3*4 v_scale pair lj/cut/coul/long epsilon 1*4 4 v_scale scale yes reset no
fix             lang all langevin 300.0 300.0 100.0 7811
fix             cap all nve/limit 0.1
timestep        1.0
thermo          1000
# RUNTIME: 2500 steps
run             2500
unfix           cap
unfix           lang
unfix           ramp
undump          bbdump
write_data      system_ramped.data
