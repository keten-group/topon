# --- 5. Equilibration Loop (Set 1 Logic) ---
undump          bbdump
reset_timestep  0
dump            bbdump bbdump custom 10 traj_stage3.lammpstrj id xu yu zu
dump_modify     bbdump sort id format float %.4f append yes

variable        temp equal 300
velocity        all create ${temp} 12345
velocity        all create 300 12345

# NVT (1000 steps)
fix             1 all nvt temp ${temp} ${temp} 100.0
fix             1 all nvt temp 300 ${temp} 100.0
fix             1 all nvt temp 300 300 100.0
run             1000
