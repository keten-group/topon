{
    "study": {
        "name": "atomistic_entangled",
        "output_dir": "output_atomistic_entangled"
    },
    "topology": {
        "source": "generate",
        "generator": {
            "lattice_size": "5x5x5",
            "lattice_type": "SC",
            "max_functionality": 4,
            "degree_distribution": "0:0,1:25"
        }
    },
    "chemistry": {
        "model_type": "atomistic",
        "monomer_type": "PDMS",
        "crosslinker_type": "Si",
        "degree_of_polymerization": 10
    },
    "assignment": {
        "entanglements": {
            "enabled": true,
            "target": 5,
            "target_type": "count"
        }
    },
    "conformation": {
        "overlap_cutoff": 0.2,
        "overlap_max_iters": 20
    },
    "simulation": {
        "pair_style": "dreiding",
        "dielectric": 1.0
    },
    "execution": {
        "auto_run": false,
        "executable": "lmp",
        "n_procs": 1
    }
}
