{
    "study": {
        "name": "atomistic_combined",
        "output_dir": "output_atomistic_combined"
    },
    "topology": {
        "source": "generate",
        "generator": {
            "lattice_size": "5x5x5",
            "lattice_type": "SC",
            "max_functionality": 4,
            "degree_distribution": "0:0,1:25"
        }
    },
    "chemistry": {
        "model_type": "atomistic",
        "target_density": 0.9,
        "degree_of_polymerization": 20
    },
    "assignment": {
        "entanglements": {
            "enabled": true,
            "target": 5,
            "target_type": "count"
        },
        "grafts": {
            "enabled": true,
            "per_edge_type": {
                "A": {
                    "graft_density": 0.05,
                    "side_chain_dp": 5,
                    "side_chain_monomer": "PDMS"
                }
            }
        }
    },
    "conformation": {
        "overlap_cutoff": 0.2,
        "overlap_max_iters": 20
    },
    "simulation": {
        "run_steps": 2000
    },
    "execution": {
        "auto_run": false,
        "executable": "lmp",
        "n_procs": 1
    }
}
