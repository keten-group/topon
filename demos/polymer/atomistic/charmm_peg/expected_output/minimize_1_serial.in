# LAMMPS Stage 1: hard-backbone push-off (ATOMISTIC, CHARMM, protocol "hard_backbone")
#
# Backbone-backbone pairs (atom types 1 2 4) keep a soft
# core of 60.0 kcal/mol out to 3.0 A from the first
# step; every pair with a light atom ramps 0 -> 30.0 kcal/mol at
# 1.0 A. The .soft settings carry the bonded terms with 1-4
# weights 0. Capped displacement under a Langevin thermostat, no minimiser.

units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     charmm
dihedral_style  charmm
improper_style  harmonic
special_bonds   charmm
pair_style      soft 3.0

read_data       ../03_Conformation/system_relaxed.data
include         ../02_Chemistry/system.in.settings.soft
pair_coeff      * * 0.0 1.0
pair_coeff      1 1 60.0 3.0
pair_coeff      1 2 60.0 3.0
pair_coeff      1 4 60.0 3.0
pair_coeff      2 2 60.0 3.0
pair_coeff      2 4 60.0 3.0
pair_coeff      4 4 60.0 3.0
include         ../02_Chemistry/system.groups

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     mode single cutoff 12.0

group           bbdump type 1 2 4
dump            bbdump bbdump custom 10 traj_stage1.lammpstrj id xu yu zu
dump_modify     bbdump sort id format float %.4f

variable        prefactor equal ramp(0,30.0)
fix             light all adapt 1 pair soft a 1*3 3 v_prefactor pair soft a 3 4*4 v_prefactor reset no
velocity        all create 300.0 4928459 dist gaussian
fix             lang all langevin 300.0 300.0 100.0 48279
fix             cap all nve/limit 0.05
timestep        1.0
thermo          1000
run             5000
unfix           cap
unfix           lang
unfix           light
undump          bbdump
write_data      system_after_soft.data nocoeff
write_restart   1.restart
