# LAMMPS Stage 3: Parallel Equilibration (CHARMM)
# Full CHARMM: 1-4 terms in the dihedrals, arithmetic mixing, NBFIX, PPPM.

units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     charmm
dihedral_style  charmmfsw
improper_style  harmonic
special_bonds   charmm
pair_style      lj/charmmfsw/coul/long 10.0 12.0

read_data       system_ramped.data

neigh_modify    one 10000
pair_modify     mix arithmetic
kspace_style    pppm 1.0e-4
include         ../02_Chemistry/system.in.settings

thermo          100
thermo_style    custom step pe ke etotal evdwl ecoul epair ebond eangle edihed eimp press vol temp

min_style       cg
minimize        1.0e-6 1.0e-8 100000 1000000
write_data      system_minimized_final.data

reset_timestep  0
variable        temp equal 300
velocity        all create ${temp} 12345
timestep        1.0

# NVT (1000 steps)
fix             1 all nvt temp ${temp} ${temp} 100.0
run             1000
unfix           1
write_data      after_nvt_real.data

# NPT (1000 steps)
fix             1 all npt temp ${temp} ${temp} 100.0 iso 1.0 1.0 1000.0
run             1000
unfix           1

write_data      system_equilibrated.data
print "All Minimization Stages Complete."
