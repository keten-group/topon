# LAMMPS Stage 2: epsilon ramp with the backbone at full depth (CHARMM, protocol "hard_backbone")
#
# CHARMM LJ without 1-4 terms (lj/cut/coul/long, arithmetic mixing, NBFIX);
# pairs with a light atom ramp from 0.001 to 1 of their depth, backbone
# pairs (types 1 2 4) are at full depth from the first
# step. No soft pre-minimisation: the historic CHARMM ramp opens with one.

units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     charmm
dihedral_style  charmm
improper_style  harmonic
special_bonds   charmm
pair_style      lj/cut/coul/long 12.0
pair_modify     mix arithmetic
kspace_style    pppm 1.0e-4

read_data       system_after_soft.data
include         ../02_Chemistry/system.in.settings.soft
include         ../02_Chemistry/system.in.settings.lj

neigh_modify    one 10000
comm_modify     mode single cutoff 12.0

group           bbdump type 1 2 4
dump            bbdump bbdump custom 10 traj_stage2.lammpstrj id xu yu zu
dump_modify     bbdump sort id format float %.4f

variable        scale equal ramp(0.001,1.0)
fix             ramp all adapt 1 pair lj/cut/coul/long epsilon 1*3 3 v_scale pair lj/cut/coul/long epsilon 3 4*4 v_scale scale yes reset no
fix             lang all langevin 300.0 300.0 100.0 7811
fix             cap all nve/limit 0.1
timestep        1.0
thermo          1000
# RUNTIME: 5000 steps
run             5000
unfix           cap
unfix           lang
unfix           ramp
undump          bbdump
write_data      system_ramped.data nocoeff
