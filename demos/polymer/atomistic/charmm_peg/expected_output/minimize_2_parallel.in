# LAMMPS Stage 2: Parallel Ramp (CHARMM)
# CHARMM LJ (no 1-4) with arithmetic mixing and NBFIX, epsilon ramped
# 0.001 -> 1 under nve/limit; stage 3 turns the full CHARMM set on.

units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     charmm
dihedral_style  charmm
improper_style  harmonic
special_bonds   charmm
pair_style      soft 1.0

read_data       system_after_soft.data
include         ../02_Chemistry/system.in.settings.soft
pair_coeff      * * 1.0

neigh_modify    one 10000
comm_modify     mode single cutoff 12.0

min_style       cg
minimize        1.0e-4 1.0e-6 1000 10000

pair_style      lj/cut/coul/long 12.0
pair_modify     mix arithmetic
kspace_style    pppm 1.0e-4
include         ../02_Chemistry/system.in.settings.lj

variable        scale equal "ramp(0.001, 1.0)"
timestep        1.0
fix             1 all adapt 1 pair lj/cut/coul/long epsilon * * v_scale scale yes
fix             fxnve all nve/limit 0.1
thermo          1000
run             10000
unfix           fxnve
unfix           1

write_data      system_ramped.data nocoeff
