  read_data CPU = 0.108 seconds

neigh_modify    one 10000
pair_modify     mix arithmetic
kspace_style    pppm 1.0e-4
include         ../02_Chemistry/system.in.settings
# CHARMM force-field coefficients (topon). Units real (kcal/mol, Angstrom).

# pair_coeff i i  epsilon sigma epsilon_14 sigma_14  (lj/charmm*)
pair_coeff 1 1 0.032000 3.563595 0.010000 3.385415 # CC30A
pair_coeff 2 2 0.056000 3.581413 0.010000 3.385415 # CC32A
pair_coeff 3 3 0.035000 2.387609 0.035000 2.387609 # HCA2A
pair_coeff 4 4 0.100000 2.939966 0.100000 2.939966 # OC30A

# bond_coeff  K  r0  (harmonic, E = K (r - r0)^2)
bond_coeff 1 222.5000 1.5380 # CC30A-CC32A
bond_coeff 2 222.5000 1.5300 # CC32A-CC32A
bond_coeff 3 309.0000 1.1110 # CC32A-HCA2A
bond_coeff 4 360.0000 1.4150 # CC32A-OC30A

# angle_coeff  K  theta0  K_ub  r_ub  (charmm)
angle_coeff 1 26.5000 110.1000 22.5300 2.1790 # CC30A-CC32A-HCA2A
angle_coeff 2 45.0000 111.5000 0.0000 0.0000 # CC30A-CC32A-OC30A
angle_coeff 3 58.3500 113.5000 11.1600 2.5610 # CC32A-CC30A-CC32A
angle_coeff 4 26.5000 110.1000 22.5300 2.1790 # CC32A-CC32A-HCA2A
angle_coeff 5 45.0000 111.5000 0.0000 0.0000 # CC32A-CC32A-OC30A
angle_coeff 6 95.0000 109.7000 0.0000 0.0000 # CC32A-OC30A-CC32A
angle_coeff 7 35.5000 109.0000 5.4000 1.8020 # HCA2A-CC32A-HCA2A
angle_coeff 8 60.0000 109.5000 0.0000 0.0000 # HCA2A-CC32A-OC30A

# dihedral_coeff  K  n  d  w  (charmm; w = 1-4 weight)
dihedral_coeff 1 0.5700 1 0 1.0000 # CC30A-CC32A-OC30A-CC32A
dihedral_coeff 2 0.2900 2 0 0.0000 # CC30A-CC32A-OC30A-CC32A
dihedral_coeff 3 0.4300 3 0 0.0000 # CC30A-CC32A-OC30A-CC32A
dihedral_coeff 4 0.2000 3 0 1.0000 # CC32A-CC30A-CC32A-HCA2A
dihedral_coeff 5 0.1600 1 180 1.0000 # CC32A-CC30A-CC32A-OC30A
dihedral_coeff 6 0.3900 2 0 0.0000 # CC32A-CC30A-CC32A-OC30A
dihedral_coeff 7 0.5700 1 0 1.0000 # CC32A-CC32A-OC30A-CC32A
dihedral_coeff 8 0.2900 2 0 0.0000 # CC32A-CC32A-OC30A-CC32A
dihedral_coeff 9 0.4300 3 0 0.0000 # CC32A-CC32A-OC30A-CC32A
dihedral_coeff 10 0.2840 3 0 1.0000 # CC32A-OC30A-CC32A-HCA2A
dihedral_coeff 11 0.1900 3 0 1.0000 # HCA2A-CC32A-CC32A-HCA2A
dihedral_coeff 12 0.1900 3 0 1.0000 # HCA2A-CC32A-CC32A-OC30A
dihedral_coeff 13 0.5900 1 180 1.0000 # OC30A-CC32A-CC32A-OC30A
dihedral_coeff 14 1.1600 2 0 0.0000 # OC30A-CC32A-CC32A-OC30A

# improper_coeff  K  psi0  (harmonic)

thermo          100
thermo_style    custom step pe ke etotal evdwl ecoul epair ebond eangle edihed eimp press vol temp

min_style       cg
minimize        1.0e-6 1.0e-8 100000 1000000
