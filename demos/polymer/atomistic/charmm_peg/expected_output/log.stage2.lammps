# LAMMPS Stage 2: Parallel Ramp (CHARMM)
# CHARMM LJ (no 1-4) with arithmetic mixing and NBFIX, epsilon ramped
# 0.001 -> 1 under nve/limit; stage 3 turns the full CHARMM set on.

units           real
atom_style      full
boundary        p p p
bond_style      harmonic
angle_style     charmm
dihedral_style  charmm
improper_style  harmonic
special_bonds   charmm
pair_style      soft 1.0

read_data       system_after_soft.data
