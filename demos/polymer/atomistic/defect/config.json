{
    "study": {
        "name": "atomistic_defect",
        "output_dir": "output_atomistic_defect"
    },
    "topology": {
        "source": "generate",
        "generator": {
            "lattice_size": "5x5x5",
            "lattice_type": "SC",
            "max_functionality": 4,
            "degree_distribution": "0:0,1:24,2:30,3:40,4:31",
