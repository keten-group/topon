                "enabled": true,
                "count": 5
            }
        }
    },
    "conformation": {
        "overlap_cutoff": 0.2,
        "overlap_max_iters": 20
    },
    "simulation": {
        "run_steps": 2000
    },
    "execution": {
        "auto_run": false,
        "executable": "lmp",
        "n_procs": 1
    }
}
